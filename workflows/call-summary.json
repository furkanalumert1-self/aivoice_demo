        "bodyParameters": {
          "parameters": [
            {
              "name": "callerPhone",
              "value": "={{ $('Webhook').item.json.callerPhone }}"
            },
            {
              "name": "durationSeconds",
              "value": "={{ $('Webhook').item.json.durationSeconds }}"
            },
            {
              "name": "transcript",
              "value": "={{ $('Webhook').item.json.transcript }}"
            },
            {
              "name": "summary",
              "value": "={{ $json.message.content }}"
            },
            {
              "name": "cost",
              "value": "={{ $('Webhook').item.json.cost }}"
            },
            {
              "name": "outcome",
              "value": "={{ $('Webhook').item.json.outcome }}"
            }
          ]
        }
      },
      "id": "4a5b6c7d-0004-0004-0004-000000000003",
      "name": "Insert Call Log",
