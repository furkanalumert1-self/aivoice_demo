{
  "name": "Klinik AI - Çağrı Özeti",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "call-summary",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-node",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "chat",
        "operation": "complete",
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "Sen bir tıbbi call center asistanısın. Verilen transkripti analiz ederek kısa ve öz bir özet çıkar. Özet Türkçe olmalı ve 2-3 cümleyi geçmemeli."
            },
            {
              "role": "user",
              "content": "Aşağıdaki çağrı transkriptini özetle:\n\n{{ $json.transcript }}"
            }
          ]
        },
        "options": {
          "maxTokens": 200
        }
      },
      "id": "gpt-summary-node",
      "name": "GPT Özeti Oluştur",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.3,
      "position": [460, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-key",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "calls",
        "columns": "caller_phone,duration_seconds,transcript,summary,cost,outcome,recording_url",
        "additionalFields": {}
      },
      "id": "insert-call-node",
      "name": "Çağrı Kaydı Ekle",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [680, 300],
      "credentials": {
        "postgres": {
          "id": "neon-db",
          "name": "Neon PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "notifications",
        "columns": "title,description,is_read",
        "additionalFields": {}
      },
      "id": "create-notification-node",
      "name": "Bildirim Oluştur",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [900, 300],
      "credentials": {
        "postgres": {
          "id": "neon-db",
          "name": "Neon PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, callId: $('Çağrı Kaydı Ekle').item.json.id } }}"
      },
      "id": "respond-node",
      "name": "Yanıt Ver",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "GPT Özeti Oluştur", "type": "main", "index": 0 }]]
    },
    "GPT Özeti Oluştur": {
      "main": [[{ "node": "Çağrı Kaydı Ekle", "type": "main", "index": 0 }]]
    },
    "Çağrı Kaydı Ekle": {
      "main": [[{ "node": "Bildirim Oluştur", "type": "main", "index": 0 }]]
    },
    "Bildirim Oluştur": {
      "main": [[{ "node": "Yanıt Ver", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["klinik-ai", "call", "summary", "gpt"]
}
