{
  "name": "Klinik AI - Randevu Hatırlatıcı",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "minutesInterval": 0,
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "cron-node",
      "name": "Zamanlanmış Tetikleyici",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM appointments WHERE appointment_at::date = (CURRENT_DATE + INTERVAL '1 day') AND status = 'onaylandi'",
        "options": {}
      },
      "id": "find-appointments-node",
      "name": "Yarınki Randevuları Bul",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [460, 300],
      "credentials": {
        "postgres": {
          "id": "neon-db",
          "name": "Neon PostgreSQL"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-items",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "check-appointments-node",
      "name": "Randevu Var mı?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const appointments = $input.all();\nconst reminders = [];\n\nfor (const appt of appointments) {\n  const data = appt.json;\n  const appointmentTime = new Date(data.appointment_at)\n    .toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' });\n  reminders.push({\n    title: `Randevu Hatırlatıcısı — ${data.patient_name}`,\n    description: `Sayın ${data.patient_name}, yarın saat ${appointmentTime} için ${data.doctor_name} ile randevunuz bulunmaktadır.`,\n    is_read: false,\n    patientName: data.patient_name,\n    appointmentAt: data.appointment_at\n  });\n}\n\nreturn reminders.map(r => ({ json: r }));"
      },
      "id": "prepare-reminders-node",
      "name": "Hatırlatıcıları Hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "notifications",
        "columns": "title,description,is_read",
        "additionalFields": {}
      },
      "id": "save-reminder-node",
      "name": "Hatırlatıcı Bildirimi Kaydet",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [1120, 200],
      "credentials": {
        "postgres": {
          "id": "neon-db",
          "name": "Neon PostgreSQL"
        }
      }
    }
  ],
  "connections": {
    "Zamanlanmış Tetikleyici": {
      "main": [[{ "node": "Yarınki Randevuları Bul", "type": "main", "index": 0 }]]
    },
    "Yarınki Randevuları Bul": {
      "main": [[{ "node": "Randevu Var mı?", "type": "main", "index": 0 }]]
    },
    "Randevu Var mı?": {
      "main": [
        [{ "node": "Hatırlatıcıları Hazırla", "type": "main", "index": 0 }],
        []
      ]
    },
    "Hatırlatıcıları Hazırla": {
      "main": [[{ "node": "Hatırlatıcı Bildirimi Kaydet", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": ["klinik-ai", "reminder", "cron", "internal-event"]
}
