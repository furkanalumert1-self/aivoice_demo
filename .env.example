# ============================================================
# Klinik AI Call Center — Environment Variables
# ============================================================
# Bu dosyayı .env.local olarak kopyala ve değerleri doldur:
#   cp .env.example .env.local
#
# .env.local asla git'e commit edilmez (.gitignore'da)
# Production için Vercel Dashboard → Settings → Environment Variables
#
# Admin Sayfaları:
#   /admin           — dashboard
#   /admin/appointments — randevu kayıtları
#   /admin/calls     — çağrı kayıtları
#   /admin/monitoring — workflow execution takibi
#   /admin/analytics — çağrı analitiği
#   /admin/health    — sistem sağlığı
#   /admin/audit     — sistem olayları & audit kayıtları
# ============================================================


# ============================================================
# NEON POSTGRESQL — Veritabanı Bağlantısı
# Nereden: console.neon.tech → Projen → Connection Details → Connection String
# Format:  postgresql://[user]:[password]@[host]/[database]?sslmode=require
# Hangi sistem: Next.js API routes (db/index.ts → Drizzle ORM)
# Güvenlik: SERVER-SIDE ONLY — asla NEXT_PUBLIC_ yapma
# ============================================================
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require


# ============================================================
# CLERK AUTHENTICATION — Kullanıcı Kimlik Doğrulama
# Nereden: dashboard.clerk.com → API Keys
# Hangi sistem: Admin dashboard oturum yönetimi
# ============================================================

# Publishable Key — tarayıcıda görünebilir (tasarımı böyle)
# Nereden: Clerk Dashboard → API Keys → Publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret Key — ASLA client-side'a verme
# Nereden: Clerk Dashboard → API Keys → Secret keys → Show
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================
# VAPI.AI — Sesli AI Altyapısı
# Nereden: dashboard.vapi.ai → Account Settings → API Keys → Create new key
# Hangi sistem: Next.js API routes (outbound call, webhook doğrulama)
# Güvenlik: SERVER-SIDE ONLY — asla NEXT_PUBLIC_ yapma
# ============================================================
VAPI_API_KEY=vapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_ASSISTANT_ID=asst_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPI_PHONE_NUMBER_ID=pn_xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================
# OPENAI — AI Modeli
# Nereden: platform.openai.com/api-keys → Create new secret key
# Hangi sistem: n8n call-summary workflow (GPT-4o-mini transkript özeti)
# Not: n8n'de ayrıca credential olarak da girilmeli
# Güvenlik: SERVER-SIDE ONLY
# ============================================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ============================================================
# N8N WEBHOOK — Otomasyon Entegrasyonu
# Nereden: n8n Cloud → Aktif workflow → Webhook node → Production URL
# Format:  https://[instance].app.n8n.cloud  (path YOK — sadece base URL)
# Hangi sistem: Next.js API routes (book, cancel, call-ended, doctor-info, callback)
# Webhook path'leri otomatik eklenir:
#   /webhook/appointment-created
#   /webhook/appointment-reminder
#   /webhook/call-summary
#   /webhook/appointment-cancelled
# NOT: Tüm workflow'lar DB'ye yazar — dış mesajlaşma (WhatsApp/SMS) yok
# ============================================================
N8N_WEBHOOK_BASE_URL=https://xxxx.app.n8n.cloud


# ============================================================
# UYGULAMA URL — Next.js Uygulamasının Public URL'i
# Local geliştirme: http://localhost:3000
# Production:       https://[proje-adi].vercel.app
# Hangi sistem: /api/health endpoint, admin/health sayfası
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
